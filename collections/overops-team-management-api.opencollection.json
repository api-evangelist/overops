{
  "opencollection": "1.0.0",
  "info": {
    "name": "Services Alerts Team Management API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List environment team members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.overops.com/api/v1/services/:env_id/team",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Team member email"
              }
            ]
          },
          "docs": "List team members with access to this environment"
        },
        {
          "info": {
            "name": "Add new members",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.overops.com/api/v1/services/:env_id/team",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment to use"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add new members"
        },
        {
          "info": {
            "name": "Delete members from an environment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.overops.com/api/v1/services/:env_id/team",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete members from an environment. This call requires admin role"
        },
        {
          "info": {
            "name": "Edit roles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.overops.com/api/v1/services/:env_id/team/change-role",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment to use"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit roles for selected group of users"
        }
      ]
    }
  ],
  "bundled": true
}