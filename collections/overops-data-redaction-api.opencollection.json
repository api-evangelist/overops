          },
          "docs": "List all regex patterns"
        },
        {
          "info": {
            "name": "Retrieve a pattern",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.overops.com/api/v1/services/:env_id/settings/data-redaction/patterns/:pattern",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              },
              {
                "name": "pattern",
                "value": "",
                "type": "path",
                "description": "A RegEx pattern name"
              }
            ]
