              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              },
              {
                "name": "pattern",
                "value": "",
                "type": "path",
                "description": "A RegEx pattern name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a RegEx pattern to be redacted. The pattern name must match the resource identifier"
        },
        {
          "info": {
            "name": "Delete a pattern",
            "type": "http"
          },
