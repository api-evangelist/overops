        {
          "id": "ffefae35-43b0-44ab-9b0f-aab4bb10b119",
          "name": "Fetch metric graph/data",
          "request": {
            "name": "Fetch metric graph/data",
            "description": {
              "content": "Fetch data for a specific system metric within a target timeframe, application / server / deployment set.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                ":env_id",
                "metrics",
                "system",
                ":metric_name",
                "graph"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Start time of requested graph. Date in ISO8601 format (yyyy-MM-ddTHH:mm:ss.SSSZ)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) End time of requested graph. Date in ISO8601 format (yyyy-MM-ddTHH:mm:ss.SSSZ)"
                },
                {
                  "disabled": false,
                  "key": "points",
                  "value": "<integer>",
                  "description": "Number of data points to return within the interval. **IMPORTANT:** either 'points' or 'resolution' parameters have to be passed. When both are passed, resolution takes precedence."
                },
                {
                  "disabled": false,
                  "key": "resolution",
                  "value": "<string>",
                  "description": "Select graph resolution (use M1/M5 for 1 point per 1/5 minutes; use H1/H8 for 1 point per 1/8 hours). **IMPORTANT:** either 'points' or 'resolution' parameters have to be passed. When both are passed, resolution takes precedence."
                },
                {
                  "disabled": false,
                  "key": "server",
                  "value": "<string>",
                  "description": "Server(s) added to the filter"
                },
                {
                  "disabled": false,
                  "key": "app",
                  "value": "<string>",
                  "description": "Application(s) added to the filter"
                },
                {
                  "disabled": false,
                  "key": "deployment",
                  "value": "<string>",
                  "description": "Deployment(s) added to the filter"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "env_id",
                  "description": "(Required) Environment ID to use (e.g. S1234)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "metric_name",
                  "description": "(Required) Metric name to fetch"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": null
          },
