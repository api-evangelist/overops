{
  "opencollection": "1.0.0",
  "info": {
    "name": "Services Alerts Timers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
