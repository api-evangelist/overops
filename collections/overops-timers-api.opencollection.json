            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.overops.com/api/v1/services/:env_id/timers",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              }
            ]
          },
          "docs": "List all existing timers"
        },
        {
          "info": {
            "name": "Create new timer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.overops.com/api/v1/services/:env_id/timers",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new timer"
        },
        {
          "info": {
            "name": "Get timer properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.overops.com/api/v1/services/:env_id/timers/:timer_id",
