          "http": {
            "method": "POST",
            "url": "https://api.overops.com/api/v1/services/:env_id/timers/:timer_id",
            "params": [
              {
                "name": "env_id",
                "value": "",
                "type": "path",
                "description": "Environment ID to use (e.g. S1234)"
              },
              {
                "name": "timer_id",
                "value": "",
                "type": "path",
                "description": "View to use"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
