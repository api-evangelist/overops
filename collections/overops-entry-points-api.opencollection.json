          "docs": "List all prioritized entry point classes"
        },
        {
          "info": {
            "name": "Add a class to the prioritized entry points list",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.overops.com/api/v1/services/:env_id/settings/entrypoints/prioritized/classes/:class_name",
            "params": [
              {
