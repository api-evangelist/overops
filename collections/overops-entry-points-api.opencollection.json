        },
        {
          "info": {
            "name": "Remove a package from the prioritized entry points list",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.overops.com/api/v1/services/:env_id/settings/entrypoints/prioritized/packages/:package_name",
            "params": [
